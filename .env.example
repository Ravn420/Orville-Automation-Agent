# Orville standalone runtime configuration
ORVILLE_API_TOKEN=replace-with-a-high-entropy-secret
ORVILLE_API_HOST=127.0.0.1
ORVILLE_API_PORT=8787
ORVILLE_STORAGE=sqlite
ORVILLE_DB_PATH=.orville/orville.db
# Use an explicit comma-separated allowlist in the application bootstrap for production.
ORVILLE_ALLOWED_ORIGINS=http://localhost:3000
# Set to 1 only for the packaged portable Windows release.
ORVILLE_PORTABLE=0
ORVILLE_REQUESTS_PER_MINUTE=120

# Local Python MCP bridge. It forwards authenticated read and approval-gated mutation tools to the REST API.
ORVILLE_REST_URL=http://127.0.0.1:8787
ORVILLE_MCP_HOST=127.0.0.1
ORVILLE_MCP_PORT=42069
ORVILLE_MCP_MUTATIONS_ENABLED=0

# Optional provider configuration. Never commit real credentials.
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional Stable Horde / AI Horde code generation.
# Set an active text model from https://aihorde.net/details/models/.
ORVILLE_STABLE_HORDE_API_KEY=
ORVILLE_STABLE_HORDE_MODEL=aphrodite
ORVILLE_STABLE_HORDE_BASE_URL=https://aihorde.net/api

# Optional Orville-managed Blackbox cloud relay. The Blackbox API key belongs
# on the relay server and must never be placed in this client environment file.
ORVILLE_BLACKBOX_RELAY_URL=
ORVILLE_BLACKBOX_RELAY_ALLOWED_HOSTS=
ORVILLE_BLACKBOX_RELAY_MODEL=blackboxai/openai/gpt-5.5
ORVILLE_BLACKBOX_RELAY_ENABLED=1
ORVILLE_BLACKBOX_RELAY_PLAN=managed
ORVILLE_RELAY_SUBJECT=local-device
